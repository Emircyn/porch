{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "porch",
	"compatibility_date": "2026-09-29",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },
	"services": [
		{
			// Self-reference used by OpenNext for cache revalidation; the name must match the Worker's.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "porch"
		}
	],
	// ISR cache for public pages (see open-next.config.ts). scripts/deploy.mjs creates the namespaces and
	// writes their real ids here; the placeholders work for local previews.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "a873006b97054807b27f0727d1111c98" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "f98e02102be34c62ba9c6d734f541672" }
	],
	"durable_objects": {
		"bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
	"images": {
		"binding": "IMAGES"
	}
}
