# Copy to .env.local (Next.js dev) and .dev.vars (wrangler preview). Never commit real values.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only for scripts (db:push, db:types, seed): Connect → Session pooler
SUPABASE_DB_URL=

# Stripe — test mode only (sk_test_...). Run `npx dotenv -e .env.local -- node scripts/stripe-setup.mjs`
# once to create the Pro price, then paste its id below.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
# Local: `stripe listen --print-secret`. Production: the endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dev only: host:port of a tunnel (e.g. Tailscale) allowed to reach the dev server.
DEV_TUNNEL_HOST=
